{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "retro-mp3-yt-music",
  "version": "0.1.0",
  "identifier": "dev.retromp3.ytmusic",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "retro-mp3-yt-music",
        "width": 480,
        "height": 320,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "shadow": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
